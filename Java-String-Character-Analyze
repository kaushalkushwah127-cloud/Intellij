import java.util.*;
public class Vowl {
    public static void main(String [] args){
        Scanner sc=new Scanner(System.in);
        String s=sc.nextLine();
        int vowel =0,consonant=0;
        int upper=0, lower=0;
        int digit =0, letter=0, special=0;
        int white=0;
        for (int i=0;  i<s.length(); i++){
            if (Character.isUpperCase(s.charAt(i))) upper++;
            if (Character.isLowerCase(s.charAt(i))) lower++;
            if (Character.isDigit(s.charAt(i))) digit++;
            if (Character.isLetter(s.charAt(i))) letter++;
            if (!Character.isLetterOrDigit(s.charAt(i))) {
                if (!Character.isWhitespace(s.charAt(i))) special++;
            }
            if (Character.isWhitespace(s.charAt(i))) white++;
            char c=Character.toLowerCase(s.charAt(i));
            if (c=='a'|| c=='e' || c=='i' ||c=='o' ||c=='u') vowel++;
            else if (c>='a' && c<='z') consonant++;
        }
        System.out.print("Vowel : "+vowel +"\nConsonant : "+consonant+"\nUpper Case : "+upper+"\nLower Case : "+lower+"\nDigit : "+digit+"\nAlphabet : "+letter+"\nSpecial Character : "+special+"\nWhite Space : "+white);
    }
}
