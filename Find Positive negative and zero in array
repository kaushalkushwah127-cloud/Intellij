//Count how many elements are positive, negative, or zero.
import java.util.*;
public class Count{
    public static void main (String[] args){
        Scanner sc= new Scanner (System.in);

        System.out.print("Enter the SIze of Array :");
        int x=sc.nextInt();
        int array[]= new int [x];
        System.out.print("Enter Elements :");
        for (int i=0; i<x; i++) {
            array[i] = sc.nextInt();
        }
        int positive=0,negative=0,zero=0;
        for (int i=0; i<x; i++){
            if (array[i]<0) negative++;
            else if (array[i]>0) positive++;
            else zero++;
        }
        System.out.print("Positive Elements : "+positive+"\nNegative Elements : "+negative+"\nZero Elements : "+zero);
    }
}
