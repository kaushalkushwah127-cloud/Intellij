import java.util.* ;
public class Freq {
    public static void main(String[] args) {
        Scanner sc= new Scanner (System.in);
        String s=sc.nextLine();
        int freq[]=new int [26];
        for (char i: s.toCharArray()){
            if (i >= 97 && i <= 122) freq[i-97]++;
        }
        for (int i=0; i<26; i++){
           if (freq[i]!=0) System.out.println("Frequency of "+(char)(i+97)+" = "+freq[i]);
        }
    }
}
