//Find Minimum and Maximun Element ina an Array.
import java.util.*;
public class minmax {
    public static void main (String[] args){
        Scanner sc= new Scanner (System.in);

        System.out.print("Enter the SIze of Array :");
        int x=sc.nextInt();
        int array[]= new int [x];
        System.out.print("Enter Elements :");
        for (int i=0; i<x; i++) {
            array[i] = sc.nextInt();
        }
        int min=array[0];
        int max=Integer.MIN_VALUE;
        for (int i=0; i<x; i++){
            if (array[i]>max) max=array[i];
            if (array[i]<min) min=array[i];
        }
        System.out.print("Minimun Value : "+min+"\nMaximum Value : "+max);
    }
}
