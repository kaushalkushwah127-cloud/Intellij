//Count how many elements are even and odd.
import java.util.*;
public class EvenOdd{
    public static void main (String[] args){
        Scanner sc= new Scanner (System.in);

        System.out.print("Enter the SIze of Array :");
        int x=sc.nextInt();
        int array[]= new int [x];
        System.out.print("Enter Elements :");
        for (int i=0; i<x; i++) {
            array[i] = sc.nextInt();
        }
        int even=0, odd=0;
        for (int i=0; i<x; i++){
            if (array[i]%2==0) even++;
            else odd++;
        }
        System.out.print("Even Elements : "+even+"\nOdd Elements : "+odd);
    }
}
